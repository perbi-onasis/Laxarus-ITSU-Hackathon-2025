// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  phone          String?  @unique
  email          String?  @unique
  password       String?  // For future extensibility (not used for OTP login)
  role           Role     @default(USER)
  ghanaCardUrl   String?  // URL to Ghana Card in GCS
  requests       DocumentRequest[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model DocumentRequest {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  type           DocumentType
  status         RequestStatus @default(PENDING)
  ghanaCardUrl   String?  // Redundant for quick access, also in User
  documentUrl    String?  // Final document (PDF/image) in GCS
  paymentRef     String?  // Paystack reference
  paid           Boolean  @default(false)
  rejectionReason String? // If rejected, reason
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum DocumentType {
  TRANSCRIPT
  ATTESTATION
  CERTIFICATE
}

enum RequestStatus {
  PENDING
  PAID
  APPROVED
  DELIVERED
  REJECTED
}
